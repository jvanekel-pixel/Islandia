{
  "$comment": [
    "A snapshot of the parts of StreamBox's client API that Islandia uses.",
    "",
    "StreamBox is a separate project with its own process (docs/plan/07-STREAMBOX.md).",
    "Nothing here is generated by it, and nothing in this repository pushes to it. This file was",
    "written by reading its source, and it records which commit was read so the two can be",
    "compared later. It is the single source of truth for both the mock gateway in",
    "tools/mock-streambox and the client in Island.Core: when they disagree with this file,",
    "they are wrong.",
    "",
    "It describes shapes, not secrets. No address, token or account detail appears here, and the",
    "privacy check in tools/lint enforces that."
  ],
  "contractVersion": 1,
  "source": {
    "repository": "the owner's private StreamBox repository",
    "commit": "9ebfdd6",
    "readOn": "2026-11-10",
    "note": "StreamBox is under active development. Re-read and bump contractVersion when it moves."
  },

  "transport": {
    "basePath": "/api",
    "auth": {
      "scheme": "bearer",
      "header": "Authorization",
      "obtainedBy": "pairing",
      "note": "The device token is a revocable device session. A 401, or a Connect close with code 4401, means it is gone: return to pairing."
    },
    "tolerance": {
      "unknownFields": "ignore",
      "unknownEnumValues": "degrade to a documented fallback, never throw",
      "note": "StreamBox will add fields and enum cases. An older Islandia build must keep working."
    }
  },

  "pairing": {
    "$comment": "RFC 8628-style device flow. The headset shows a code, a signed-in phone approves it.",
    "start": {
      "method": "POST", "path": "/pair/start", "auth": false,
      "response": {
        "code": "string",
        "pollSecret": "string",
        "expiresAt": "iso-datetime",
        "approveUrl": "url",
        "intervalSeconds": "int>0"
      }
    },
    "poll": {
      "method": "POST", "path": "/pair/poll", "auth": false,
      "request": { "pollSecret": "string" },
      "response": {
        "discriminator": "status",
        "pending": {},
        "denied": {},
        "expired": {},
        "approved": { "deviceToken": "string", "userName": "string", "profileName": "string|null" }
      },
      "note": "The token is handed over exactly once. Poll no faster than intervalSeconds."
    }
  },

  "catalog": {
    "home":             { "method": "GET", "path": "/catalog/home" },
    "latest":           { "method": "GET", "path": "/catalog/latest" },
    "nextUp":           { "method": "GET", "path": "/catalog/next-up" },
    "resume":           { "method": "GET", "path": "/catalog/resume" },
    "libraryItems":     { "method": "GET", "path": "/catalog/libraries/{id}/items" },
    "collections":      { "method": "GET", "path": "/catalog/collections" },
    "collection":       { "method": "GET", "path": "/catalog/collections/{id}" },
    "search":           { "method": "GET", "path": "/catalog/search" },

    "itemKinds": ["movie", "series", "season", "episode"],
    "item": {
      "required": ["id", "kind", "libraryId", "name", "genres", "tags", "studios", "providerIds", "images"],
      "optional": ["year", "overview", "tagline", "runtimeMs", "officialRating", "communityRating",
                   "people", "series", "seasonNumber", "seasonId", "episodeNumber", "childCount",
                   "episodeCount", "status", "media", "progress", "addedAt"],
      "images": { "poster": "image?", "backdrop": "image?", "logo": "image?", "thumb": "image?" },
      "image":  { "url": "string", "blurhash": "string?", "aspect": "number?" }
    },
    "page": {
      "items": "item[]", "total": "int", "offset": "int", "limit": "int",
      "nextOffset": "int?", "ceilinged": "bool?"
    }
  },

  "playback": {
    "play": {
      "method": "POST", "path": "/play",
      "request": {
        "itemId": "string",
        "capabilities": {
          "name": "lowercase slug",
          "video": "codec[]", "audio": "codec[]",
          "hdr": "bool", "maxWidth": "int", "maxHeight": "int",
          "maxAudioChannels": "int", "segmentContainer": "mp4|ts"
        },
        "optional": ["audioIndex", "subtitleIndex", "startMs", "maxBitrate", "burnSubtitle"]
      },
      "response": {
        "streamId": "uuid", "url": "hls master playlist", "decision": "remux|transcode",
        "reasons": "string[]", "expiresAt": "iso-datetime", "remote": "bool",
        "transcodes4k": "bool", "burnedInSubtitle": "int|null", "subtitles": "track[]",
        "optional": ["durationMs", "maxBitrate", "audioIndex"]
      }
    },
    "stop":   { "method": "DELETE", "path": "/play/{token}" },
    "active": { "method": "GET", "path": "/play/active" },

    "islandiaCapabilities": {
      "$comment": "Confirmed against a real device by work package V-14. Quest 2 decodes H.264 and stereo AAC in hardware; anything beyond that must be proven before it is claimed.",
      "name": "islandia",
      "video": ["h264"], "audio": ["aac"],
      "hdr": false, "maxWidth": 1920, "maxHeight": 1080,
      "maxAudioChannels": 2, "segmentContainer": "ts"
    },
    "streamSweptAfterIdleMs": 300000,
    "renewAfterPauseMs": 240000,
    "note": "The gateway sweeps an idle stream after about five minutes. After a longer pause, request a fresh stream at the saved position rather than resuming the old one."
  },

  "music": {
    "home":      { "method": "GET",  "path": "/music/home" },
    "albums":    { "method": "GET",  "path": "/music/albums" },
    "album":     { "method": "GET",  "path": "/music/albums/{id}" },
    "artists":   { "method": "GET",  "path": "/music/artists" },
    "playlists": { "method": "GET",  "path": "/music/playlists" },
    "search":    { "method": "GET",  "path": "/music/search" },
    "favorites": { "method": "GET",  "path": "/music/favorites" },
    "play":      { "method": "POST", "path": "/music/play", "response": { "url": "signed audio url" } },
    "scrobble":  { "method": "POST", "path": "/music/scrobble" },
    "note": "The play response is a signed address needing no header, and it supports range requests. That is what lets the headset fetch a track into a bounded cache and play from disk instead of decoding a live socket."
  },

  "progress": {
    "report":  { "method": "POST", "path": "/progress/events" },
    "item":    { "method": "GET",  "path": "/progress/items/{id}" },
    "next":    { "method": "GET",  "path": "/progress/items/{id}/next" },
    "tracks":  { "method": "GET",  "path": "/progress/items/{id}/tracks" },
    "eventKinds": ["heartbeat", "pause", "seek", "stop", "track_change", "background", "start_over"],
    "event": {
      "required": ["id", "kind", "itemId", "profileId", "playbackId", "playbackStartedAt", "clientTs", "positionMs"],
      "optional": ["durationMs", "data"],
      "note": "The id is generated by the client so a replay after a dropped connection is idempotent."
    },
    "state": {
      "required": ["positionMs", "watched", "playCount", "inProgress", "hidden", "run"],
      "optional": ["durationMs", "fraction", "watchedAt", "lastPlayedAt", "watchedCount"]
    },
    "note": "StreamBox owns the progress rules and covers them with property tests. Islandia reports events and does not re-implement them."
  },

  "connect": {
    "path": "/connect",
    "transport": "websocket",
    "hello": { "type": "hello", "role": "tv", "token": "device token" },
    "commandsIslandiaMustHandle": [
      "play", "pause", "resume", "seek", "seekBy", "stop", "next",
      "audio", "subtitle", "volume", "mute"
    ],
    "stateFields": [
      "itemId", "positionMs", "durationMs", "playing", "buffering",
      "audio", "audioIndex", "subtitles", "subtitleIndex", "volume", "muted", "hasNext"
    ],
    "closeCodes": { "4401": "signedOut", "4409": "replaced" },
    "note": "Neither close code may be retried. 4401 means the token is gone; 4409 means a newer socket replaced this one."
  }
}
